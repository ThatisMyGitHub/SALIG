# Copy to .env and keep the real file outside Git.

# Required: immutable LocalAI image reference.
# Do not use latest, master or another floating tag.
SALIG_LOCALAI_IMAGE=quay.io/go-skynet/local-ai@sha256:REPLACE_WITH_APPROVED_DIGEST

# Required: long random key used only by the SalutApp AI Gateway.
# Generate, for example, with: openssl rand -base64 48
SALIG_API_KEY=REPLACE_WITH_LONG_RANDOM_GATEWAY_KEY

# QNAP persistent data root. Models are mounted read-only at runtime.
SALIG_DATA_ROOT=/share/data/dockerapps/salig

# Existing internal network shared with the SalutApp AI Gateway.
SALUTAPP_INTERNAL_NETWORK=salutapp-app-internal

# Conservative proof-of-concept resource envelope. Adjust only after measured tests.
SALIG_CPU_LIMIT=4.0
SALIG_MEMORY_LIMIT=12g
SALIG_PIDS_LIMIT=512
SALIG_TMPFS_SIZE=1g
